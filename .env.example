# Create a Google OAuth web client and register this app's HTTPS origin.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Keep this key server-only; restrict it to the YouTube Data API.
GOOGLE_YOUTUBE_API_KEY=

# Optional alternative to the server's Node.js 22+ runtime, e.g. deno:G:/tools/deno.exe
YT_DLP_JS_RUNTIME=


# Optional account sync. Use a claimed, private MantleDB namespace; keep both values server-only.
MANTLEDB_NAMESPACE=
MANTLEDB_KEY=

# Signs sync session cookies. Keep separate from MANTLEDB_KEY so storage access
# never doubles as session-forging power. Any long random string works.
SYNC_SESSION_SECRET=

# Optional: cookies.txt exported from a YouTube-signed-in browser. Prevents
# "Sign in to confirm you're not a bot" blocks on datacenter IPs.
YT_DLP_COOKIE_FILE=
