{
  "id": "/",
  "name": "Aurora Music",
  "short_name": "Aurora",
  "description": "A focused, installable music player for listening, discovery, and your library.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b0d0b",
  "theme_color": "#0b0d0b",
  "categories": ["music", "entertainment"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/aurora.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/aurora.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Search music",
      "short_name": "Search",
      "description": "Find songs, albums, artists, and playlists.",
      "url": "/search",
      "icons": [{ "src": "/aurora.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Open library",
      "short_name": "Library",
      "description": "Open your saved music library.",
      "url": "/library",
      "icons": [{ "src": "/aurora.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Listen together",
      "short_name": "Together",
      "description": "Open a synchronized listening room.",
      "url": "/room",
      "icons": [{ "src": "/aurora.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
